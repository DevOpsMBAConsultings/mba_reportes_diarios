<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        Cierre Mensual de Ventas.

        Solo define la cabecera con el filtro Mes + Año; todo el cuerpo
        (KPIs, sesiones, métodos de pago, órdenes y productos) se reutiliza
        del cierre diario via t-call, para que las dos pantallas no puedan
        divergir.
    -->
    <t t-name="mba_reportes_diarios.MonthlyClosingReportTemplate" owl="1">
        <div class="o_mba_report">
            <div
                class="o_mba_report_header d-flex flex-wrap justify-content-between align-items-center gap-3"
            >
                <div>
                    <h2 class="o_mba_report_title">Cierre Mensual</h2>
                    <div class="o_mba_report_subtitle">
                        Empresa: <strong t-esc="state.data.company_name" />
                        | Período: <strong t-esc="periodLabel" />
                        | Generado: <span t-esc="state.data.time_report" />
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-primary" t-on-click="printPdf">
                        <i class="fa fa-print me-1" /> Imprimir (PDF)
                    </button>
                    <button class="btn btn-secondary" t-on-click="exportXlsx">
                        <i class="fa fa-file-excel-o me-1" /> Exportar (XLSX)
                    </button>

                    <div class="d-flex align-items-center gap-1 ms-2">
                        <span class="small text-muted">Desde:</span>
                        <input type="date" class="form-control form-control-sm" t-model="state.date_from" t-on-change="onFilterChange"/>
                        <span class="small text-muted ms-1">Hasta:</span>
                        <input type="date" class="form-control form-control-sm" t-model="state.date_to" t-on-change="onFilterChange"/>
                    </div>
                </div>
            </div>

            <t t-call="mba_reportes_diarios.ClosingReportBody" />
        </div>
    </t>

</templates>
