<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mba_reportes_diarios.MonthlyIncomeReportTemplate" owl="1">
        <div class="o_mba_report">
            <!-- Header & Filter Bar -->
            <div class="o_mba_report_header d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <h2 class="o_mba_report_title">Resumen Mensual de Ingresos (MTD)</h2>
                    <div class="o_mba_report_subtitle">
                        Empresa: <strong t-esc="state.data.company_name"/> | Rango: <span t-esc="state.date_from"/> al <span t-esc="state.date_to"/> | Generado: <span t-esc="state.data.time_report"/>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-primary" t-on-click="printPdf">
                        <i class="fa fa-print me-1"/> Imprimir (PDF)
                    </button>
                    <button class="btn btn-secondary" t-on-click="exportXlsx">
                        <i class="fa fa-file-excel-o me-1"/> Exportar (XLSX)
                    </button>

                    <div class="d-flex align-items-center gap-1 ms-3">
                        <span class="small text-muted">Desde:</span>
                        <input type="date" class="form-control form-control-sm" t-model="state.date_from" t-on-change="onDateChange"/>
                        <span class="small text-muted ms-1">Hasta:</span>
                        <input type="date" class="form-control form-control-sm" t-model="state.date_to" t-on-change="onDateChange"/>
                    </div>
                </div>
            </div>

            <!-- Loading Spinner -->
            <t t-if="state.loading">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <div class="mt-2 text-muted">Cargando matriz acumulada mensual...</div>
                </div>
            </t>

            <t t-else="">
                <!-- KPI Summary Cards -->
                <div class="o_mba_report_kpis">
                    <div class="o_mba_report_kpi o_mba_kpi_success">
                        <div class="o_mba_kpi_label">Total Ingresos Acumulado (MTD)</div>
                        <div class="o_mba_kpi_value" t-esc="state.data.formatted_grand_total_mtd"/>
                    </div>
                    <div class="o_mba_report_kpi o_mba_kpi_info">
                        <div class="o_mba_kpi_label">Facturación a Crédito Emitida (Informativo)</div>
                        <div class="o_mba_kpi_value" t-esc="state.data.formatted_credit_total_mtd"/>
                    </div>
                </div>

                <!-- Table 1: Matriz Horizontal MTD (Día por Día) -->
                <div class="o_mba_report_section">
                    <div class="o_mba_report_section_header">
                        <h3 class="o_mba_report_section_title">Evolución Diaria de Ingresos (MTD)</h3>
                    </div>
                    <div class="table-responsive">
                        <table class="o_mba_report_table">
                            <thead>
                                <tr>
                                    <th style="min-width: 220px; position: sticky; left: 0; background-color: #f1f3f5; z-index: 2;">Concepto de Ingreso</th>
                                    <t t-foreach="state.data.day_headers" t-as="h" t-key="h.date">
                                        <th class="text-end" style="min-width: 90px;">
                                            <div t-esc="h.label"/>
                                            <small class="text-muted fw-normal" t-esc="h.day_name"/>
                                        </th>
                                    </t>
                                    <th class="text-end text-primary" style="min-width: 120px; position: sticky; right: 0; background-color: #f1f3f5; z-index: 2;">TOTAL MTD</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="state.data.concept_rows" t-as="row" t-key="row.name">
                                    <tr t-att-class="row.informative ? 'bg-light text-muted' : ''">
                                        <td style="position: sticky; left: 0; background-color: inherit; z-index: 1;">
                                            <strong t-esc="row.name"/>
                                            <t t-if="row.informative">
                                                <small class="ms-1 text-muted">(Informativo)</small>
                                            </t>
                                        </td>
                                        <t t-foreach="row.formatted_values" t-as="val" t-key="val_index">
                                            <td class="o_mba_amount" t-esc="val"/>
                                        </t>
                                        <td class="o_mba_amount fw-bold" style="position: sticky; right: 0; background-color: inherit; z-index: 1;" t-esc="row.formatted_total"/>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr class="o_mba_total_row">
                                    <td style="position: sticky; left: 0; background-color: #f1f3f5; z-index: 1;">TOTAL INGRESOS DÍA:</td>
                                    <t t-foreach="state.data.formatted_daily_totals" t-as="dt" t-key="dt_index">
                                        <td class="o_mba_amount text-primary" t-esc="dt"/>
                                    </t>
                                    <td class="o_mba_amount text-primary fs-6" style="position: sticky; right: 0; background-color: #f1f3f5; z-index: 1;" t-esc="state.data.formatted_grand_total_mtd"/>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
