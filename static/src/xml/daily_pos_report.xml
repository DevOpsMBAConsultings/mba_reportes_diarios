<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mba_reportes_diarios.DailyPosReportTemplate" owl="1">
        <div class="o_daily_cxc_report">
            <!-- Header & Filter Bar -->
            <div class="o_daily_cxc_header d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <h2 class="report_title">Cierre de Caja - Punto de Venta (POS)</h2>
                    <div class="report_subtitle">
                        Empresa: <strong t-esc="state.data.company_name"/> | Generado: <span t-esc="state.data.time_report"/>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-primary" t-on-click="printPdf">
                        <i class="fa fa-print me-1"/> Imprimir (PDF)
                    </button>
                    <button class="btn btn-secondary" t-on-click="exportXlsx">
                        <i class="fa fa-file-excel-o me-1"/> Exportar (XLSX)
                    </button>

                    <div class="input-group input-group-sm ms-3" style="width: auto;">
                        <span class="input-group-text bg-white"><i class="fa fa-calendar"/> Fecha</span>
                        <input type="date" class="form-control" t-model="state.date_report" t-on-change="onDateChange"/>
                    </div>
                </div>
            </div>

            <!-- Loading Spinner -->
            <t t-if="state.loading">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <div class="mt-2 text-muted">Cargando reporte de cierre POS...</div>
                </div>
            </t>

            <t t-else="">
                <!-- KPI Summary Cards -->
                <div class="o_daily_cxc_kpis">
                    <div class="o_cxc_kpi_card kpi_success">
                        <div class="kpi_title">Total Ventas POS</div>
                        <div class="kpi_value" t-esc="state.data.formatted_total_ventas"/>
                    </div>
                    <div class="o_cxc_kpi_card kpi_info">
                        <div class="kpi_title">Total Órdenes POS</div>
                        <div class="kpi_value" t-esc="state.data.total_ordenes"/>
                    </div>
                    <div class="o_cxc_kpi_card">
                        <div class="kpi_title">Total ITBMS (Impuestos)</div>
                        <div class="kpi_value" t-esc="state.data.formatted_total_impuestos"/>
                    </div>
                    <div class="o_cxc_kpi_card">
                        <div class="kpi_title">Total Recaudado por Métodos</div>
                        <div class="kpi_value" t-esc="state.data.formatted_total_pagos"/>
                    </div>
                </div>

                <!-- Table 1: Sesiones POS y Métodos de Pago -->
                <div class="row">
                    <div class="col-md-6">
                        <div class="o_cxc_card">
                            <div class="o_cxc_card_header">
                                <h3 class="o_cxc_card_title">Sesiones del Día</h3>
                            </div>
                            <table class="table-cxc">
                                <thead>
                                    <tr>
                                        <th>Sesión</th>
                                        <th>Caja / Punto</th>
                                        <th>Cajero</th>
                                        <th>Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="!state.data.sessions || state.data.sessions.length === 0">
                                        <tr>
                                            <td colspan="4" class="text-center py-3 text-muted">No se abrieron sesiones en esta fecha.</td>
                                        </tr>
                                    </t>
                                    <t t-foreach="state.data.sessions" t-as="s" t-key="s.name">
                                        <tr>
                                            <td class="fw-bold" t-esc="s.name"/>
                                            <td t-esc="s.config_name"/>
                                            <td t-esc="s.user"/>
                                            <td>
                                                <span class="badge bg-success" t-esc="s.state"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="o_cxc_card">
                            <div class="o_cxc_card_header">
                                <h3 class="o_cxc_card_title">Desglose por Métodos de Pago POS</h3>
                            </div>
                            <table class="table-cxc">
                                <thead>
                                    <tr>
                                        <th>Método de Pago</th>
                                        <th class="text-end">Transacciones</th>
                                        <th class="text-end">Monto Recaudado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="!state.data.payment_methods || state.data.payment_methods.length === 0">
                                        <tr>
                                            <td colspan="3" class="text-center py-3 text-muted">No hay pagos registrados.</td>
                                        </tr>
                                    </t>
                                    <t t-foreach="state.data.payment_methods" t-as="pm" t-key="pm.name">
                                        <tr>
                                            <td class="fw-bold" t-esc="pm.name"/>
                                            <td class="text-end" t-esc="pm.count"/>
                                            <td class="text-amount" t-esc="pm.formatted_amount"/>
                                        </tr>
                                    </t>
                                </tbody>
                                <tfoot>
                                    <tr class="total-row">
                                        <td colspan="2" class="text-end">TOTAL RECAUDADO:</td>
                                        <td class="text-amount text-primary" t-esc="state.data.formatted_total_pagos"/>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Table 2: Detalle de Órdenes POS -->
                <div class="o_cxc_card">
                    <div class="o_cxc_card_header">
                        <h3 class="o_cxc_card_title">Órdenes POS del Día</h3>
                        <span class="badge bg-secondary" t-esc="state.data.total_ordenes + ' Órdenes'"/>
                    </div>
                    <div class="table-responsive">
                        <table class="table-cxc">
                            <thead>
                                <tr>
                                    <th>Orden</th>
                                    <th>Cliente</th>
                                    <th>Hora</th>
                                    <th>Método de Pago</th>
                                    <th class="text-end">Subtotal</th>
                                    <th class="text-end">ITBMS</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="!state.data.orders || state.data.orders.length === 0">
                                    <tr>
                                        <td colspan="7" class="text-center py-4 text-muted">No hay órdenes registradas en esta fecha.</td>
                                    </tr>
                                </t>
                                <t t-foreach="state.data.orders" t-as="o" t-key="o.order_id">
                                    <tr>
                                        <td>
                                            <span class="clickable-link" t-on-click="() => this.openOrder(o.order_id)">
                                                <t t-esc="o.name"/>
                                            </span>
                                        </td>
                                        <td>
                                            <t t-if="o.partner_id">
                                                <span class="clickable-link" t-on-click="() => this.openPartner(o.partner_id)">
                                                    <t t-esc="o.partner"/>
                                                </span>
                                            </t>
                                            <t t-else="">
                                                <t t-esc="o.partner"/>
                                            </t>
                                        </td>
                                        <td t-esc="o.date"/>
                                        <td><span class="badge bg-light text-dark border" t-esc="o.payment_method"/></td>
                                        <td class="text-amount" t-esc="o.formatted_amount_untaxed"/>
                                        <td class="text-amount" t-esc="o.formatted_amount_tax"/>
                                        <td class="text-amount fw-bold" t-esc="o.formatted_amount_total"/>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr class="total-row">
                                    <td colspan="4" class="text-end">TOTALES ÓRDENES:</td>
                                    <td class="text-amount" t-esc="state.data.order_totals.formatted_amount_untaxed"/>
                                    <td class="text-amount" t-esc="state.data.order_totals.formatted_amount_tax"/>
                                    <td class="text-amount text-primary" t-esc="state.data.order_totals.formatted_amount_total"/>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <!-- Table 3: Productos Vendidos en POS -->
                <div class="o_cxc_card">
                    <div class="o_cxc_card_header">
                        <h3 class="o_cxc_card_title">Productos Vendidos en el POS</h3>
                        <span class="badge bg-secondary" t-esc="state.data.products.length + ' Productos'"/>
                    </div>
                    <div class="table-responsive">
                        <table class="table-cxc">
                            <thead>
                                <tr>
                                    <th>Código</th>
                                    <th>Descripción</th>
                                    <th class="text-end">Cantidad</th>
                                    <th class="text-end">Monto Bruto</th>
                                    <th class="text-end">ITBMS</th>
                                    <th class="text-end">Monto Neto</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="!state.data.products || state.data.products.length === 0">
                                    <tr>
                                        <td colspan="6" class="text-center py-3 text-muted">No hay productos vendidos.</td>
                                    </tr>
                                </t>
                                <t t-foreach="state.data.products" t-as="p" t-key="p.product_id">
                                    <tr>
                                        <td t-esc="p.item"/>
                                        <td>
                                            <span class="clickable-link" t-on-click="() => this.openProduct(p.product_id)">
                                                <t t-esc="p.descripcion"/>
                                            </span>
                                        </td>
                                        <td class="text-amount" t-esc="p.formatted_cantidad"/>
                                        <td class="text-amount" t-esc="p.formatted_monto_bruto"/>
                                        <td class="text-amount" t-esc="p.formatted_impuestos"/>
                                        <td class="text-amount" t-esc="p.formatted_monto_neto"/>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr class="total-row">
                                    <td colspan="2" class="text-end">TOTALES PRODUCTOS:</td>
                                    <td class="text-amount" t-esc="state.data.prod_totals.formatted_cantidad"/>
                                    <td class="text-amount" t-esc="state.data.prod_totals.formatted_monto_bruto"/>
                                    <td class="text-amount" t-esc="state.data.prod_totals.formatted_impuestos"/>
                                    <td class="text-amount" t-esc="state.data.prod_totals.formatted_monto_neto"/>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
