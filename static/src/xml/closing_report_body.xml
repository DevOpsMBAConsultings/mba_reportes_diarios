<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        Cuerpo compartido del cierre de ventas.

        Lo usan tanto el Cierre Diario como el Cierre Mensual via t-call.
        Solo cambia la cabecera (filtro de fecha vs filtro de mes); las
        secciones de KPIs, sesiones, metodos de pago, ordenes y productos
        son identicas y se mantienen en un solo sitio para que no diverjan.
    -->
    <t t-name="mba_reportes_diarios.ClosingReportBody" owl="1">
            <!-- Loading Spinner -->
            <t t-if="state.loading">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <div class="mt-2 text-muted">Cargando reporte de cierre POS...</div>
                </div>
            </t>

            <t t-else="">
                <!-- Fila 1: KPIs de Ventas y Resultados -->
                <div class="o_mba_report_kpis mb-1">
                    <div class="o_mba_report_kpi o_mba_kpi_success">
                        <div class="o_mba_kpi_label">
                            Total Ventas
                            <i class="fa fa-question-circle text-muted ms-1" data-tooltip="Monto total neto cobrado/facturado con impuestos. Incluye facturas de venta menos notas de crédito." title="Monto total neto cobrado/facturado con impuestos. Incluye facturas de venta menos notas de crédito."></i>
                        </div>
                        <div class="o_mba_kpi_value" t-esc="state.data.formatted_total_ventas"/>
                    </div>
                    <div class="o_mba_report_kpi o_mba_kpi_info">
                        <div class="o_mba_kpi_label">
                            Total Órdenes
                            <i class="fa fa-question-circle text-muted ms-1" data-tooltip="Total de transacciones procesadas en el período (incluye facturas de venta y notas de crédito)." title="Total de transacciones procesadas en el período (incluye facturas de venta y notas de crédito)."></i>
                        </div>
                        <div class="o_mba_kpi_value" t-esc="state.data.total_ordenes"/>
                    </div>
                    <div class="o_mba_report_kpi">
                        <div class="o_mba_kpi_label">
                            Total ITBMS (Impuestos)
                            <i class="fa fa-question-circle text-muted ms-1" data-tooltip="Impuesto acumulado neto (ITBMS en ventas menos ITBMS deducido por notas de crédito)." title="Impuesto acumulado neto (ITBMS en ventas menos ITBMS deducido por notas de crédito)."></i>
                        </div>
                        <div class="o_mba_kpi_value" t-esc="state.data.formatted_total_impuestos"/>
                    </div>
                    <div class="o_mba_report_kpi">
                        <div class="o_mba_kpi_label">
                            Total Recaudado por Métodos
                            <i class="fa fa-question-circle text-muted ms-1" data-tooltip="Suma total de cobros recibidos clasificados por métodos de pago (Efectivo, ACH, Tarjeta, Crédito, etc.)." title="Suma total de cobros recibidos clasificados por métodos de pago (Efectivo, ACH, Tarjeta, Crédito, etc.)."></i>
                        </div>
                        <div class="o_mba_kpi_value" t-esc="state.data.formatted_total_pagos"/>
                    </div>
                    <t t-if="state.data.cost_inventory and state.data.cost_inventory.available">
                        <div class="o_mba_report_kpi">
                            <div class="o_mba_kpi_label">
                                Costo de Ventas
                                <i class="fa fa-question-circle text-muted ms-1" data-tooltip="Costo agnóstico de los productos vendidos (basado en capas SVL de inventario o costo estándar del producto)." title="Costo agnóstico de los productos vendidos (basado en capas SVL de inventario o costo estándar del producto)."></i>
                            </div>
                            <div class="o_mba_kpi_value text-danger" t-esc="state.data.cost_inventory.formatted_costo_ventas"/>
                        </div>
                        <div class="o_mba_report_kpi o_mba_kpi_success">
                            <div class="o_mba_kpi_label">
                                Utilidad Bruta
                                <i class="fa fa-question-circle text-muted ms-1" data-tooltip="Ganancia bruta obtenida: Ventas brutas sin impuestos menos el Costo de Ventas (% Margen Bruto)." title="Ganancia bruta obtenida: Ventas brutas sin impuestos menos el Costo de Ventas (% Margen Bruto)."></i>
                            </div>
                            <div class="o_mba_kpi_value">
                                <t t-esc="state.data.cost_inventory.formatted_utilidad_bruta"/>
                                <small class="text-muted" style="font-size: 65%;"> (<t t-esc="state.data.cost_inventory.formatted_margen_pct"/>)</small>
                            </div>
                        </div>
                    </t>
                </div>

                <!-- Fila 2: KPIs de Inventario Operativo -->
                <t t-if="state.data.cost_inventory and state.data.cost_inventory.available">
                    <div class="o_mba_report_kpis border-top-0 pt-0">
                        <div class="o_mba_report_kpi">
                            <div class="o_mba_kpi_label">
                                Físico en Bodega (Stock > 0)
                                <i class="fa fa-question-circle text-muted ms-1" data-tooltip="Valor total de la mercancía depositada físicamente en repisas." title="Valor total de la mercancía depositada físicamente en repisas."></i>
                            </div>
                            <div class="o_mba_kpi_value" t-esc="state.data.cost_inventory.formatted_fisico_bruto"/>
                        </div>
                        <div class="o_mba_report_kpi">
                            <div class="o_mba_kpi_label">
                                Déficit Vtas. Negativas
                                <i class="fa fa-question-circle text-muted ms-1" data-tooltip="Valor de los productos facturados/despachados en saldo negativo." title="Valor de los productos facturados/despachados en saldo negativo."></i>
                            </div>
                            <div class="o_mba_kpi_value text-danger" t-esc="'- ' + state.data.cost_inventory.formatted_deficit_negativo"/>
                        </div>
                        <div class="o_mba_report_kpi">
                            <div class="o_mba_kpi_label">
                                Compras en Tránsito
                                <i class="fa fa-question-circle text-muted ms-1" data-tooltip="Compras confirmadas pendientes de recibir." title="Compras confirmadas pendientes de recibir."></i>
                            </div>
                            <div class="o_mba_kpi_value text-primary" t-esc="'+ ' + state.data.cost_inventory.formatted_compras_transito"/>
                        </div>
                        <div class="o_mba_report_kpi o_mba_kpi_info">
                            <div class="o_mba_kpi_label">
                                Inv. Operativo Proyectado
                                <i class="fa fa-question-circle text-muted ms-1" data-tooltip="Inventario Físico + Compras en Tránsito - Déficit Negativo." title="Inventario Físico + Compras en Tránsito - Déficit Negativo."></i>
                            </div>
                            <div class="o_mba_kpi_value text-success fw-bold" t-esc="state.data.cost_inventory.formatted_inventario_operativo"/>
                        </div>
                    </div>
                </t>

                <!-- Table 1: Sesiones POS y Métodos de Pago -->
                <div class="row">
                    <div class="col-md-6">
                        <div class="o_mba_report_section">
                            <div class="o_mba_report_section_header" t-on-click="() => this.toggleSection('sessions')" style="cursor: pointer;">
                                <h3 class="o_mba_report_section_title">
                                    <i class="fa fa-chevron-down me-1 text-muted" t-if="!isCollapsed('sessions')"></i>
                                    <i class="fa fa-chevron-right me-1 text-muted" t-if="isCollapsed('sessions')"></i>
                                    Sesiones POS del <t t-esc="state.data.is_range ? 'Mes' : 'Día'"/>
                                </h3>
                                <span class="badge bg-secondary" t-esc="(state.data.sessions ? state.data.sessions.length : 0) + ' Sesiones'"/>
                            </div>
                            <div t-if="!isCollapsed('sessions')">
                                <table class="o_mba_report_table">
                                    <thead>
                                        <tr>
                                            <th>Sesión</th>
                                            <th>Caja / Punto</th>
                                            <th>Cajero</th>
                                            <th>Estado</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-if="!state.data.sessions || state.data.sessions.length === 0">
                                            <tr>
                                                <td colspan="4" class="text-center py-3 text-muted">No se abrieron sesiones en este período.</td>
                                            </tr>
                                        </t>
                                        <t t-else="">
                                            <t t-foreach="state.data.sessions" t-as="s" t-key="s.name">
                                                <tr>
                                                    <td class="fw-bold" t-esc="s.name"/>
                                                    <td t-esc="s.config_name"/>
                                                    <td t-esc="s.user"/>
                                                    <td>
                                                        <span class="badge bg-success" t-esc="s.state"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="o_mba_report_section">
                            <div class="o_mba_report_section_header" t-on-click="() => this.toggleSection('payments')" style="cursor: pointer;">
                                <h3 class="o_mba_report_section_title">
                                    <i class="fa fa-chevron-down me-1 text-muted" t-if="!isCollapsed('payments')"></i>
                                    <i class="fa fa-chevron-right me-1 text-muted" t-if="isCollapsed('payments')"></i>
                                    Desglose por Métodos de Pago
                                </h3>
                                <span class="o_mba_amount fw-bold text-primary" t-esc="state.data.formatted_total_pagos"/>
                            </div>
                            <div t-if="!isCollapsed('payments')">
                                <table class="o_mba_report_table">
                                    <thead>
                                        <tr>
                                            <th>Método de Pago</th>
                                            <th class="text-end">Transacciones</th>
                                            <th class="text-end">Monto Recaudado</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-if="!state.data.payment_methods || state.data.payment_methods.length === 0">
                                            <tr>
                                                <td colspan="3" class="text-center py-3 text-muted">No hay pagos registrados.</td>
                                            </tr>
                                        </t>
                                        <t t-else="">
                                            <t t-foreach="state.data.payment_methods" t-as="pm" t-key="pm.name">
                                                <tr>
                                                    <td class="fw-bold" t-esc="pm.name"/>
                                                    <td class="text-end" t-esc="pm.count"/>
                                                    <td class="o_mba_amount" t-esc="pm.formatted_amount"/>
                                                </tr>
                                            </t>
                                        </t>
                                    </tbody>
                                    <tfoot>
                                        <tr class="o_mba_total_row">
                                            <td colspan="2" class="text-end">TOTAL RECAUDADO:</td>
                                            <td class="o_mba_amount text-primary" t-esc="state.data.formatted_total_pagos"/>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Table 2: Detalle de Órdenes POS -->
                <div class="o_mba_report_section">
                    <div class="o_mba_report_section_header" t-on-click="() => this.toggleSection('orders')" style="cursor: pointer;">
                        <h3 class="o_mba_report_section_title">
                            <i class="fa fa-chevron-down me-1 text-muted" t-if="!isCollapsed('orders')"></i>
                            <i class="fa fa-chevron-right me-1 text-muted" t-if="isCollapsed('orders')"></i>
                            Detalle de Órdenes del <t t-esc="state.data.is_range ? 'Mes' : 'Día'"/>
                        </h3>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-secondary" t-esc="(state.data.orders ? state.data.orders.length : 0) + ' Órdenes'"/>
                            <span class="o_mba_amount fw-bold" t-if="state.data.order_totals" t-esc="state.data.order_totals.formatted_amount_total"/>
                        </div>
                    </div>
                    <div t-if="!isCollapsed('orders')" class="table-responsive">
                        <table class="o_mba_report_table">
                            <thead>
                                <tr>
                                    <th>Orden</th>
                                    <th>Cliente</th>
                                    <th>Hora</th>
                                    <th>Método de Pago</th>
                                    <th class="text-end">Subtotal</th>
                                    <th class="text-end">ITBMS</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="!state.data.orders || state.data.orders.length === 0">
                                    <tr>
                                        <td colspan="7" class="text-center py-4 text-muted">No hay órdenes registradas en este período.</td>
                                    </tr>
                                </t>
                                <t t-else="">
                                    <t t-foreach="state.data.orders" t-as="o" t-key="o.order_id">
                                        <tr>
                                            <td>
                                                <span class="o_mba_link" t-on-click="() => this.openOrder(o.order_id)">
                                                    <t t-esc="o.name"/>
                                                </span>
                                            </td>
                                            <td>
                                                <t t-if="o.partner_id">
                                                    <span class="o_mba_link" t-on-click="() => this.openPartner(o.partner_id)">
                                                        <t t-esc="o.partner"/>
                                                    </span>
                                                </t>
                                                <t t-else="">
                                                    <t t-esc="o.partner"/>
                                                </t>
                                            </td>
                                            <td t-esc="o.date"/>
                                            <td><span class="badge bg-light text-dark border" t-esc="o.payment_method"/></td>
                                            <td class="o_mba_amount" t-esc="o.formatted_amount_untaxed"/>
                                            <td class="o_mba_amount" t-esc="o.formatted_amount_tax"/>
                                            <td class="o_mba_amount fw-bold" t-esc="o.formatted_amount_total"/>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                            <tfoot>
                                <t t-if="state.data.order_totals">
                                    <tr class="o_mba_total_row">
                                        <td colspan="4" class="text-end">TOTALES ÓRDENES:</td>
                                        <td class="o_mba_amount" t-esc="state.data.order_totals.formatted_amount_untaxed"/>
                                        <td class="o_mba_amount" t-esc="state.data.order_totals.formatted_amount_tax"/>
                                        <td class="o_mba_amount text-primary" t-esc="state.data.order_totals.formatted_amount_total"/>
                                    </tr>
                                </t>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <!-- Table 3: Productos Vendidos en POS -->
                <div class="o_mba_report_section">
                    <div class="o_mba_report_section_header" t-on-click="() => this.toggleSection('products')" style="cursor: pointer;">
                        <h3 class="o_mba_report_section_title">
                            <i class="fa fa-chevron-down me-1 text-muted" t-if="!isCollapsed('products')"></i>
                            <i class="fa fa-chevron-right me-1 text-muted" t-if="isCollapsed('products')"></i>
                            Productos Vendidos en el <t t-esc="state.data.is_range ? 'Mes' : 'Día'"/>
                        </h3>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-secondary" t-esc="(state.data.products ? state.data.products.length : 0) + ' Productos'"/>
                            <span class="o_mba_amount fw-bold" t-if="state.data.prod_totals" t-esc="state.data.prod_totals.formatted_monto_neto"/>
                        </div>
                    </div>
                    <div t-if="!isCollapsed('products')" class="table-responsive">
                        <table class="o_mba_report_table">
                            <thead>
                                <tr>
                                    <th>Código</th>
                                    <th>Descripción</th>
                                    <th class="text-end">Cantidad</th>
                                    <th class="text-end">Monto Bruto</th>
                                    <th class="text-end">ITBMS</th>
                                    <th class="text-end">Monto Neto</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="!state.data.products || state.data.products.length === 0">
                                    <tr>
                                        <td colspan="6" class="text-center py-3 text-muted">No hay productos vendidos.</td>
                                    </tr>
                                </t>
                                <t t-else="">
                                    <t t-foreach="state.data.products" t-as="p" t-key="p.product_id">
                                        <tr>
                                            <td t-esc="p.item"/>
                                            <td>
                                                <span class="o_mba_link" t-on-click="() => this.openProduct(p.product_id)">
                                                    <t t-esc="p.descripcion"/>
                                                </span>
                                            </td>
                                            <td class="o_mba_amount" t-esc="p.formatted_cantidad"/>
                                            <td class="o_mba_amount" t-esc="p.formatted_monto_bruto"/>
                                            <td class="o_mba_amount" t-esc="p.formatted_impuestos"/>
                                            <td class="o_mba_amount" t-esc="p.formatted_monto_neto"/>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                            <tfoot>
                                <t t-if="state.data.prod_totals">
                                    <tr class="o_mba_total_row">
                                        <td colspan="2" class="text-end">TOTALES PRODUCTOS:</td>
                                        <td class="o_mba_amount" t-esc="state.data.prod_totals.formatted_cantidad"/>
                                        <td class="o_mba_amount" t-esc="state.data.prod_totals.formatted_monto_bruto"/>
                                        <td class="o_mba_amount" t-esc="state.data.prod_totals.formatted_impuestos"/>
                                        <td class="o_mba_amount" t-esc="state.data.prod_totals.formatted_monto_neto"/>
                                    </tr>
                                </t>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <!-- Table 4: Detalle de Inventario x Departamentos -->
                <t t-if="state.data.cost_inventory and state.data.cost_inventory.available">
                    <div class="o_mba_report_section">
                        <div class="o_mba_report_section_header" t-on-click="() => this.toggleSection('inventory')" style="cursor: pointer;">
                            <h3 class="o_mba_report_section_title">
                                <i class="fa fa-chevron-down me-1 text-muted" t-if="!isCollapsed('inventory')"></i>
                                <i class="fa fa-chevron-right me-1 text-muted" t-if="isCollapsed('inventory')"></i>
                                Detalle de Inventario x Departamentos
                            </h3>
                            <div class="d-flex align-items-center gap-3">
                                <span class="badge bg-secondary" t-esc="(state.data.cost_inventory.inventario_categorias ? state.data.cost_inventory.inventario_categorias.length : 0) + ' Departamentos'"/>
                                <t t-if="state.data.cost_inventory.totals">
                                    <span class="small text-muted">Ventas: <strong t-esc="state.data.cost_inventory.totals.formatted_ventas"/></span>
                                    <span class="small text-danger">Costo: <strong t-esc="state.data.cost_inventory.totals.formatted_costo"/></span>
                                    <span class="small text-success">Utilidad: <strong t-esc="state.data.cost_inventory.totals.formatted_utilidad"/></span>
                                </t>
                            </div>
                        </div>
                        <div t-if="!isCollapsed('inventory')" class="table-responsive">
                            <table class="o_mba_report_table">
                                <thead>
                                    <tr>
                                        <th>Descripción</th>
                                        <th class="text-end">Valor Inventario</th>
                                        <th class="text-end">Porc.</th>
                                        <th class="text-end">Total Ventas</th>
                                        <th class="text-end">Cto. de Venta</th>
                                        <th class="text-end">Utilidad</th>
                                        <th class="text-end">Porc.</th>
                                        <th class="text-end">T. Compras</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="!state.data.cost_inventory.inventario_categorias or state.data.cost_inventory.inventario_categorias.length === 0">
                                        <tr>
                                            <td colspan="8" class="text-center py-3 text-muted">No hay datos de inventario.</td>
                                        </tr>
                                    </t>
                                    <t t-else="">
                                        <t t-foreach="state.data.cost_inventory.inventario_categorias" t-as="c" t-key="c.categ_id">
                                            <tr>
                                                <td t-esc="c.name"/>
                                                <td class="o_mba_amount" t-esc="c.formatted_valor"/>
                                                <td class="o_mba_amount" t-esc="c.formatted_porc"/>
                                                <td class="o_mba_amount" t-esc="c.formatted_ventas"/>
                                                <td class="o_mba_amount" t-esc="c.formatted_costo"/>
                                                <td class="o_mba_amount" t-esc="c.formatted_utilidad"/>
                                                <td class="o_mba_amount" t-esc="c.formatted_margen_pct"/>
                                                <td class="o_mba_amount" t-esc="c.formatted_compras"/>
                                            </tr>
                                        </t>
                                    </t>
                                </tbody>
                                <tfoot>
                                    <t t-if="state.data.cost_inventory.totals">
                                        <tr class="o_mba_total_row">
                                            <td class="text-end">TOTALES DEPARTAMENTOS:</td>
                                            <td class="o_mba_amount" t-esc="state.data.cost_inventory.totals.formatted_valor"/>
                                            <td class="o_mba_amount" t-esc="state.data.cost_inventory.totals.formatted_porc"/>
                                            <td class="o_mba_amount" t-esc="state.data.cost_inventory.totals.formatted_ventas"/>
                                            <td class="o_mba_amount" t-esc="state.data.cost_inventory.totals.formatted_costo"/>
                                            <td class="o_mba_amount" t-esc="state.data.cost_inventory.totals.formatted_utilidad"/>
                                            <td class="o_mba_amount" t-esc="state.data.cost_inventory.totals.formatted_margen_pct"/>
                                            <td class="o_mba_amount" t-esc="state.data.cost_inventory.totals.formatted_compras"/>
                                        </tr>
                                    </t>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </t>
            </t>
    </t>

</templates>
