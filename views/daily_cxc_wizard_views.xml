<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════
         Vista Form: Wizard Cobros de Cuentas por Cobrar (CxC)
         ══════════════════════════════════════════════════════════════════ -->
    <record id="view_daily_cxc_wizard_form" model="ir.ui.view">
        <field name="name">mba.daily.cxc.wizard.form</field>
        <field name="model">mba.daily.cxc.wizard</field>
        <field name="arch" type="xml">
            <form string="Cobros de Cuentas por Cobrar (CxC)">
                <group>
                    <group>
                        <field name="date_report"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_report"
                            string="Generar Reporte PDF"
                            type="object"
                            class="btn-primary"
                            icon="fa-print"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Acción de ventana del wizard -->
    <record id="action_daily_cxc_wizard" model="ir.actions.act_window">
        <field name="name">Cobros de Cuentas por Cobrar (CxC)</field>
        <field name="res_model">mba.daily.cxc.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
