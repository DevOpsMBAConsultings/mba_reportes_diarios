<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Form del Wizard de Comisiones -->
    <record id="view_sales_commission_wizard_form" model="ir.ui.view">
        <field name="name">mba.sales.commission.wizard.form</field>
        <field name="model">mba.sales.commission.wizard</field>
        <field name="arch" type="xml">
            <form string="Comisiones de Ventas (Pre-Cierre)">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="agent_id"/>
                    </group>
                    <group>
                        <field name="settlement_state"/>
                        <field name="payment_state"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_report"
                            string="Generar Reporte PDF"
                            type="object"
                            class="btn-primary"
                            icon="fa-print"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Acción de ventana del wizard (modal clásico) -->
    <record id="action_sales_commission_wizard" model="ir.actions.act_window">
        <field name="name">Comisiones de Ventas (Pre-Cierre)</field>
        <field name="res_model">mba.sales.commission.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Acción de Cliente Dinámico (OWL Frontend) -->
    <record id="action_sales_commission_client" model="ir.actions.client">
        <field name="name">Comisiones de Ventas (Pre-Cierre)</field>
        <field name="tag">mba_sales_commission_report</field>
    </record>
</odoo>
