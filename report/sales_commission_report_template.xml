<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_sales_commission_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-set="data" t-value="o._get_report_data()"/>
                    <div class="page">
                        <h2 class="text-center">Comisiones de Ventas (Pre-Cierre)</h2>
                        <div class="text-center text-muted mb-4">
                            Periodo del <span t-esc="data['date_from']"/> al <span t-esc="data['date_to']"/> |
                            Empresa: <span t-esc="data['company'].name"/>
                        </div>

                        <t t-if="not data['oca_installed']">
                            <div class="alert alert-warning text-center">
                                El módulo de comisiones OCA (account_commission_oca) no está instalado en este sistema.
                            </div>
                        </t>
                        <t t-else="">
                            <table class="table table-sm table-bordered">
                                <thead class="table-light">
                                    <tr>
                                        <th>Agente / Vendedor</th>
                                        <th class="text-end">Total Ventas Base</th>
                                        <th class="text-end">Comisión Pendiente</th>
                                        <th class="text-end">Comisión Liquidada</th>
                                        <th class="text-end">TOTAL COMISIÓN</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="data['agents']" t-as="ag">
                                        <tr>
                                            <td class="fw-bold" t-esc="ag['agent_name']"/>
                                            <td class="text-end" t-esc="o.fmt(ag['sales_total'])"/>
                                            <td class="text-end text-warning" t-esc="o.fmt(ag['pending_total'])"/>
                                            <td class="text-end text-success" t-esc="o.fmt(ag['settled_total'])"/>
                                            <td class="text-end fw-bold" t-esc="o.fmt(ag['commission_total'])"/>
                                        </tr>
                                    </t>
                                </tbody>
                                <tfoot>
                                    <tr class="table-secondary fw-bold">
                                        <td>TOTALES:</td>
                                        <td class="text-end" t-esc="o.fmt(data['total_sales'])"/>
                                        <td class="text-end" t-esc="o.fmt(data['total_pending'])"/>
                                        <td class="text-end" t-esc="o.fmt(data['total_settled'])"/>
                                        <td class="text-end" t-esc="o.fmt(data['total_commission'])"/>
                                    </tr>
                                </tfoot>
                            </table>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
