<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Acción del Reporte PDF para Comisiones de Ventas -->
    <record id="action_report_sales_commission" model="ir.actions.report">
        <field name="name">Comisiones de Ventas (Pre-Cierre)</field>
        <field name="model">mba.sales.commission.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mba_reportes_diarios.report_sales_commission_document</field>
        <field name="report_file">mba_reportes_diarios.report_sales_commission_document</field>
        <field name="print_report_name">'Comisiones_Ventas_%s' % (object.date_from)</field>
        <field name="binding_model_id" ref="model_mba_sales_commission_wizard"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
