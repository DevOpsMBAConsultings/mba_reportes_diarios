<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ══════════════════════════════════════════════════════════════
             Registros iniciales del Catálogo de Reportes
             ══════════════════════════════════════════════════════════════ -->

        <!-- Reporte 1: Cierre de Caja — Facturación -->
        <record id="report_template_daily_invoice" model="mba.report.template">
            <field name="name">Cierre de Caja - Facturación</field>
            <field name="description">Reporte diario de cierre de caja basado en facturas (account.move) y pagos recibidos (account.payment). Incluye resumen de operaciones, transacciones del día y productos vendidos.</field>
            <field name="sequence">10</field>
            <field name="icon">fa-file-text-o</field>
            <field name="required_module"/>
            <field name="wizard_action_xmlid">mba_reportes_diarios.action_daily_invoice_client</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Reporte 2: Cobros de Cuentas por Cobrar (CxC) -->
        <record id="report_template_daily_cxc" model="mba.report.template">
            <field name="name">Cobros de Cuentas por Cobrar (CxC)</field>
            <field name="description">Reporte diario de abonos, cobros de cartera y entradas de Cuentas por Cobrar. Muestra el resumen por banco/diario y el detalle por cliente.</field>
            <field name="sequence">15</field>
            <field name="icon">fa-money</field>
            <field name="required_module"/>
            <field name="wizard_action_xmlid">mba_reportes_diarios.action_daily_cxc_client</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Reporte 3: Cierre de Caja — POS -->
        <record id="report_template_daily_pos" model="mba.report.template">
            <field name="name">Cierre de Caja - Punto de Venta (POS)</field>
            <field name="description">Reporte diario de cierre de caja del Punto de Venta. Incluye resumen de sesiones POS, desglose por método de pago, detalle de órdenes y productos vendidos. Requiere el módulo point_of_sale.</field>
            <field name="sequence">20</field>
            <field name="icon">fa-shopping-cart</field>
            <field name="required_module">point_of_sale</field>
            <field name="wizard_action_xmlid">mba_reportes_diarios.action_daily_pos_client</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Reporte 4: Resumen Mensual de Ingresos (Month-to-Date) -->
        <record id="report_template_monthly_income" model="mba.report.template">
            <field name="name">Resumen Mensual de Ingresos (Month-to-Date)</field>
            <field name="description">Matriz mensual acumulada (MTD) que muestra la evolución día por día de los ingresos desglosados por Efectivo, Tarjeta Débito/Crédito, Transferencias, Facturas a Crédito y Cobros CxC en formato horizontal.</field>
            <field name="sequence">30</field>
            <field name="icon">fa-table</field>
            <field name="required_module"/>
            <field name="wizard_action_xmlid">mba_reportes_diarios.action_monthly_income_client</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Reporte 5: Comisiones de Ventas (Pre-Cierre) -->
        <record id="report_template_sales_commission" model="mba.report.template">
            <field name="name">Comisiones de Ventas (Pre-Cierre)</field>
            <field name="description">Auditoría y visibilidad previa de comisiones devengadas por vendedor/agente antes de procesar el pago o la liquidación oficial. Integrado con los módulos de comisiones OCA.</field>
            <field name="sequence">35</field>
            <field name="icon">fa-percent</field>
            <field name="required_module">account_commission_oca</field>
            <field name="wizard_action_xmlid">mba_reportes_diarios.action_sales_commission_client</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>

